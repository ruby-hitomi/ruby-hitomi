---
type Props = {
  href: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
};
const { href, title, description, category, pubDate } = Astro.props;
---
<article class="glass rounded-[8px] p-5">
  <p class="text-xs font-bold tracking-[0.16em] text-gold">{category}</p>
  <h3 class="mt-2 font-serif text-xl font-bold text-ruby dark:text-blush"><a href={href}>{title}</a></h3>
  <p class="mt-3 text-sm text-[color:var(--muted)]">{description}</p>
  <time class="mt-5 block text-xs text-[color:var(--muted)]" datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('ja-JP')}</time>
</article>
