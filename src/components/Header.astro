---
import { navItems, site } from '@/data/site';
---
<header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[color:var(--bg)]/88 backdrop-blur-xl">
  <div class="container flex min-h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 font-serif text-xl font-bold tracking-normal text-ruby dark:text-blush" aria-label="ルビー瞳 トップへ">
      <span class="grid size-10 place-items-center rounded-full bg-ruby text-sm text-white shadow-glass">瞳</span>
      <span>ルビー瞳</span>
    </a>
    <nav class="hidden items-center gap-5 text-sm font-medium text-[color:var(--muted)] lg:flex" aria-label="メインナビゲーション">
      {navItems.map((item) => <a class="transition hover:text-ruby dark:hover:text-blush" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <button id="themeToggle" class="grid size-10 place-items-center rounded-full border border-[var(--line)] bg-white/55 text-ruby dark:bg-white/10 dark:text-blush" type="button" aria-label="ダークモード切り替え">◐</button>
      <a class="hidden rounded-full bg-ruby px-4 py-2 text-sm font-bold text-white shadow-glass transition hover:bg-wine sm:inline-flex" href={site.bookingUrl}>予約する</a>
    </div>
  </div>
  <nav class="container flex gap-3 overflow-x-auto pb-3 text-sm text-[color:var(--muted)] lg:hidden" aria-label="モバイルナビゲーション">
    {navItems.map((item) => <a class="shrink-0 rounded-full border border-[var(--line)] bg-white/55 px-3 py-1.5 dark:bg-white/10" href={item.href}>{item.label}</a>)}
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#themeToggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
