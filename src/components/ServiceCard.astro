---
type Props = {
  title: string;
  description: string;
  price: string;
  duration: string;
  href?: string;
  ctaLabel?: string;
  badge?: string;
};
const { title, description, price, duration, href, ctaLabel = '予約へ進む', badge } = Astro.props;
---
<article class="glass relative rounded-[8px] p-6">
  {
    badge && (
      <span class="absolute right-4 top-4 rounded-full bg-gold px-3 py-1 text-xs font-bold text-ink">
        {badge}
      </span>
    )
  }
  <div class="mb-5 grid size-12 place-items-center rounded-full bg-blush text-xl text-ruby dark:bg-ruby/35 dark:text-blush">✦</div>
  <h3 class="font-serif text-2xl font-bold text-ruby dark:text-blush">{title}</h3>
  <p class="mt-3 text-sm text-[color:var(--muted)]">{description}</p>
  <div class="mt-6 flex items-end justify-between border-t border-[var(--line)] pt-5">
    <p class="text-sm text-[color:var(--muted)]">{duration}</p>
    <p class="font-serif text-2xl font-bold">{price}</p>
  </div>
  {href && <a class="mt-5 block rounded-full bg-ruby px-5 py-2.5 text-center text-sm font-bold text-white shadow-glass transition hover:bg-wine" href={href}>{ctaLabel}</a>}
</article>
