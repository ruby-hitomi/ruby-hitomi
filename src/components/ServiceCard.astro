---
type Props = {
  title: string;
  description: string;
  price: string;
  duration: string;
};
const { title, description, price, duration } = Astro.props;
---
<article class="glass rounded-[8px] p-6">
  <div class="mb-5 grid size-12 place-items-center rounded-full bg-blush text-xl text-ruby dark:bg-ruby/35 dark:text-blush">✦</div>
  <h3 class="font-serif text-2xl font-bold text-ruby dark:text-blush">{title}</h3>
  <p class="mt-3 text-sm text-[color:var(--muted)]">{description}</p>
  <div class="mt-6 flex items-end justify-between border-t border-[var(--line)] pt-5">
    <p class="text-sm text-[color:var(--muted)]">{duration}</p>
    <p class="font-serif text-2xl font-bold">{price}</p>
  </div>
</article>
