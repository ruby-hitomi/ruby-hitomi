---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTA from '@/components/CTA.astro';
import { services, testimonials, site } from '@/data/site';

const concerns = ['復縁', '相手の気持ち', '片思い', '不倫', '結婚', 'ツインレイ', '仕事', '人間関係'];
const trialService = services.find((service) => service.title.includes('初回限定')) ?? services[0];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.description,
  areaServed: '日本',
  serviceType: ['恋愛占い', '復縁占い', 'タロット占い', 'ルノルマンカード鑑定', '電話占い']
};
---
<BaseLayout title="恋愛・復縁占いのルビー瞳" description={site.description} schema={schema}>
  <section class="relative overflow-hidden">
    <div class="container grid min-h-[calc(100svh-112px)] items-center gap-10 py-10 md:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="text-sm font-bold tracking-[0.18em] text-gold">LOVE TAROT & LENORMAND</p>
        <h1 class="mt-4 font-serif text-4xl font-bold leading-tight text-ruby dark:text-blush md:text-6xl">ルビー瞳</h1>
        <p class="mt-5 max-w-xl text-lg text-[color:var(--muted)]">
          復縁、相手の気持ち、片思い、不倫、結婚。言えない恋の不安に、優しく丁寧に寄り添うオンライン鑑定です。
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="rounded-full bg-ruby px-6 py-3 text-center font-bold text-white shadow-glass transition hover:bg-wine" href={trialService.href}>初回15分を予約する</a>
          <a class="rounded-full border border-[var(--line)] bg-white/60 px-6 py-3 text-center font-bold text-ruby dark:bg-white/10 dark:text-blush" href={site.lineUrl}>LINEで質問する</a>
        </div>
        <dl class="mt-10 grid grid-cols-3 gap-3 text-center">
          <div class="glass rounded-[8px] p-3"><dt class="text-xs text-[color:var(--muted)]">占い師歴</dt><dd class="font-serif text-2xl font-bold">6年</dd></div>
          <div class="glass rounded-[8px] p-3"><dt class="text-xs text-[color:var(--muted)]">鑑定実績</dt><dd class="font-serif text-2xl font-bold">6000+</dd></div>
          <div class="glass rounded-[8px] p-3"><dt class="text-xs text-[color:var(--muted)]">初回限定</dt><dd class="font-serif text-2xl font-bold">15分</dd></div>
        </dl>
      </div>
      <div class="float-soft">
        <img class="mx-auto w-full max-w-[520px]" src="/assets/hero-ruby-hitomi.svg" width="720" height="720" alt="タロットカードとルビー色の光をあしらったルビー瞳のビジュアル" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section bg-white/35 dark:bg-white/5">
    <div class="container">
      <SectionTitle eyebrow="FIRST SESSION" title="初めての方は15分のお試し鑑定から" text="鑑定の雰囲気を知りたい方、不安を短時間で整理したい方に向けた初回限定メニューです。" />
      <div class="glass mx-auto grid max-w-3xl gap-5 rounded-[8px] p-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="font-serif text-2xl font-bold text-ruby dark:text-blush">【初回限定】通話鑑定 15分</h2>
          <p class="mt-2 text-sm text-[color:var(--muted)]">1テーマに絞って、相手の気持ちや今の状況をやさしく整理します。</p>
        </div>
        <div class="text-left md:text-right">
          <p class="font-serif text-3xl font-bold">3,000円</p>
          <a class="mt-3 inline-flex rounded-full bg-ruby px-5 py-2.5 text-sm font-bold text-white" href={trialService.href}>予約へ進む</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="MENU" title="鑑定メニュー" text="電話・通話鑑定を中心に、STORES予約からカード決済でお申し込みいただけます。" />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="section bg-white/35 dark:bg-white/5">
    <div class="container">
      <SectionTitle eyebrow="SPECIALTY" title="恋の悩みを、責めずにほどく鑑定" text="複雑な関係や言葉にしづらい気持ちも、安心してお話しください。" />
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {concerns.map((item) => <div class="glass rounded-[8px] p-5 text-center font-bold">{item}</div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid gap-8 md:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-sm font-bold tracking-[0.18em] text-gold">VOICE</p>
        <h2 class="mt-2 font-serif text-3xl font-bold text-ruby dark:text-blush">安心できる、話しやすいという声を大切にしています</h2>
      </div>
      <div class="grid gap-4">
        {testimonials.map((voice) => <blockquote class="glass rounded-[8px] p-5 text-[color:var(--muted)]">“{voice}”</blockquote>)}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
