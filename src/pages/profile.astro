---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
---
<BaseLayout title="プロフィール" description="恋愛・復縁専門の占い師ルビー瞳のプロフィール。鑑定歴6年、鑑定実績6000件以上、タロットとルノルマンカードで丁寧に寄り添います。">
  <Breadcrumbs items={[{ label: 'プロフィール' }]} />
  <section class="section pt-6">
    <div class="container grid gap-10 md:grid-cols-[0.85fr_1.15fr]">
      <img class="glass w-full rounded-[8px] p-4" src="/assets/profile-ruby-hitomi.svg" width="640" height="720" alt="ルビー瞳の鑑定スタイルを表現したカードビジュアル" />
      <div>
        <p class="text-sm font-bold tracking-[0.18em] text-gold">PROFILE</p>
        <h1 class="mt-3 font-serif text-4xl font-bold text-ruby dark:text-blush">ルビー瞳</h1>
        <p class="mt-5 text-[color:var(--muted)]">占い師歴6年、鑑定実績6000件以上。タロットとルノルマンカードを通して、恋愛、復縁、相手の気持ち、片思い、不倫、結婚、人間関係のお悩みに寄り添ってきました。</p>
        <p class="mt-4 text-[color:var(--muted)]">大切にしているのは、ただ結果を伝えるだけではなく、不安でいっぱいの心を少しずつほどきながら、今の状況を一緒に整理していくことです。安心して話せる空気の中で、これからどう動けばよいかを丁寧にお伝えします。</p>
        <p class="mt-4 text-[color:var(--muted)]">ひとりで抱え込みやすい恋の悩みだからこそ、責めずに、急かさず、その方の気持ちに寄り添う鑑定を心がけています。鑑定のあとに「少し前を向けた」と感じていただける時間をお届けできたらうれしいです。</p>
        <dl class="mt-8 grid gap-3 sm:grid-cols-3">
          <div class="glass rounded-[8px] p-4"><dt class="text-sm text-[color:var(--muted)]">鑑定歴</dt><dd class="font-serif text-2xl font-bold">6年</dd></div>
          <div class="glass rounded-[8px] p-4"><dt class="text-sm text-[color:var(--muted)]">実績</dt><dd class="font-serif text-2xl font-bold">6000件以上</dd></div>
          <div class="glass rounded-[8px] p-4"><dt class="text-sm text-[color:var(--muted)]">得意分野</dt><dd class="font-serif text-2xl font-bold">恋愛</dd></div>
        </dl>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
