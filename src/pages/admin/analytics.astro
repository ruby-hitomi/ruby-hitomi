---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const tools = [
  {
    name: 'Cloudflare Web Analytics',
    configured: Boolean(import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN),
    description: 'サイト全体のアクセス数、参照元、閲覧ページを確認します。',
    href: 'https://dash.cloudflare.com/?to=/:account/web-analytics'
  },
  {
    name: 'Google Analytics 4',
    configured: Boolean(import.meta.env.PUBLIC_GA_MEASUREMENT_ID),
    description: '予約導線のクリックイベント、外部リンククリック、流入元を確認します。',
    href: 'https://analytics.google.com/analytics/web/'
  },
  {
    name: 'Microsoft Clarity',
    configured: Boolean(import.meta.env.PUBLIC_CLARITY_PROJECT_ID),
    description: 'ヒートマップや録画で、ページ上の動きを確認します。',
    href: 'https://clarity.microsoft.com/projects'
  }
];

const events = [
  { name: 'stores_booking_click', label: 'STORES予約クリック' },
  { name: 'line_click', label: 'LINEクリック' },
  { name: 'link_click', label: '通常リンククリック' },
  { name: 'contact_click', label: 'お問い合わせクリック' },
  { name: 'phone_reading_click', label: '電話鑑定クリック' },
  { name: 'zoom_reading_click', label: 'Zoom鑑定クリック' }
];
---
<BaseLayout title="アクセス解析" description="ルビー瞳公式サイトの共通アクセス解析設定とイベント計測の確認画面。">
  <Breadcrumbs items={[{ href: '/admin/', label: '管理画面' }, { label: 'アクセス解析' }]} />
  <section class="section pt-6">
    <div class="container">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-gold">Analytics</p>
      <h1 class="mt-2 font-serif text-4xl font-bold text-ruby dark:text-blush">アクセス解析</h1>
      <p class="mt-3 max-w-3xl text-[color:var(--muted)]">
        全ページ共通のアクセス解析を `Analytics.astro` で読み込みます。管理画面配下は計測対象から除外し、予約・LINE・外部リンクのクリックを共通イベントとして送信します。
      </p>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {tools.map((tool) => (
          <article class="glass rounded-[8px] p-5">
            <div class="flex items-start justify-between gap-3">
              <h2 class="font-serif text-xl font-bold text-ruby dark:text-blush">{tool.name}</h2>
              <span class:list={[
                'shrink-0 rounded-full px-3 py-1 text-xs font-bold',
                tool.configured ? 'bg-emerald-100 text-emerald-800' : 'bg-white/70 text-[color:var(--muted)] dark:bg-white/10'
              ]}>
                {tool.configured ? '設定済み' : '未設定'}
              </span>
            </div>
            <p class="mt-3 text-sm leading-7 text-[color:var(--muted)]">{tool.description}</p>
            <a class="mt-5 inline-flex rounded-full border border-[var(--line)] px-4 py-2 text-sm font-bold text-ruby dark:text-blush" href={tool.href} target="_blank" rel="noreferrer">
              管理画面を開く
            </a>
          </article>
        ))}
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_0.9fr]">
        <section class="glass rounded-[8px] p-6">
          <h2 class="font-serif text-2xl font-bold text-ruby dark:text-blush">共通イベント</h2>
          <div class="mt-5 grid gap-3">
            {events.map((event) => (
              <div class="flex flex-col gap-1 rounded-[8px] border border-[var(--line)] bg-white/45 p-4 dark:bg-white/5 sm:flex-row sm:items-center sm:justify-between">
                <span class="font-bold">{event.label}</span>
                <code class="text-sm text-[color:var(--muted)]">{event.name}</code>
              </div>
            ))}
          </div>
        </section>

        <aside class="rounded-[8px] border border-[var(--line)] bg-white/55 p-6 text-sm leading-7 dark:bg-white/5">
          <h2 class="font-serif text-2xl font-bold text-ruby dark:text-blush">確認方法</h2>
          <ol class="mt-4 grid list-decimal gap-2 pl-5 text-[color:var(--muted)]">
            <li>公開サイトで予約ボタンやLINEボタンをクリックします。</li>
            <li>GA4のリアルタイム、またはイベント画面でイベント名を確認します。</li>
            <li>アクセス数と流入元はCloudflareまたはGA4で確認します。</li>
            <li>ページ上の動きはMicrosoft Clarityで確認します。</li>
          </ol>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
