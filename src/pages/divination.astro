---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
---
<BaseLayout title="占術紹介" description="ルビー瞳の占術紹介。タロット占いとルノルマンカードで恋愛、復縁、相手の気持ちを多面的に読み解きます。">
  <Breadcrumbs items={[{ label: '占術紹介' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">占術紹介</h1>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <article class="glass rounded-[8px] p-6">
          <p class="text-sm font-bold tracking-[0.18em] text-gold">TAROT</p>
          <h2 class="mt-2 font-serif text-3xl font-bold">タロット占い</h2>
          <p class="mt-4 text-[color:var(--muted)]">現在の気持ち、障害、未来の流れ、取るべき行動を読み解きます。復縁や片思いなど、感情の揺れが大きいご相談に向いています。</p>
        </article>
        <article class="glass rounded-[8px] p-6">
          <p class="text-sm font-bold tracking-[0.18em] text-gold">LENORMAND</p>
          <h2 class="mt-2 font-serif text-3xl font-bold">ルノルマンカード</h2>
          <p class="mt-4 text-[color:var(--muted)]">状況や人間関係のつながりを具体的に読みやすいカードです。相手の行動傾向、連絡の可能性、現実的なタイミングを見ます。</p>
        </article>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
