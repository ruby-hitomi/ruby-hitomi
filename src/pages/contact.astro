---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { site } from '@/data/site';
---
<BaseLayout title="お問い合わせ" description="ルビー瞳へのお問い合わせ。鑑定前の質問、取材、コラボ、SNS導線、LINE公式アカウントはこちら。">
  <Breadcrumbs items={[{ label: 'お問い合わせ' }]} />
  <section class="section pt-6">
    <div class="container grid gap-8 md:grid-cols-[1fr_0.9fr]">
      <div>
        <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">お問い合わせ</h1>
        <p class="mt-4 text-[color:var(--muted)]">鑑定前のご質問、取材、コラボ、SNS関連のご相談はLINEまたはメールでご連絡ください。</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="rounded-full bg-ruby px-6 py-3 text-center font-bold text-white shadow-glass" href={site.lineUrl} data-ga-event="line_click">LINE公式へ</a>
          <a class="rounded-full border border-[var(--line)] bg-white/50 px-6 py-3 text-center font-bold text-ruby dark:bg-white/10 dark:text-blush" href={`mailto:${site.email}`} data-ga-event="contact_click">メールで問い合わせる</a>
        </div>
      </div>
      <aside class="glass rounded-[8px] p-6">
        <h2 class="font-serif text-2xl font-bold">SNS</h2>
        <ul class="mt-4 grid gap-3 text-[color:var(--muted)]">
          <li><a href={site.socials.instagram}>Instagram</a></li>
          <li><a href={site.socials.tiktok}>TikTok</a></li>
          <li><a href={site.socials.x}>X</a></li>
          <li><a href={site.socials.youtube}>YouTube</a></li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
