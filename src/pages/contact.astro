---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { site } from '@/data/site';
---
<BaseLayout title="お問い合わせ" description="ルビー瞳へのお問い合わせ。鑑定前の確認、メニュー選び、予約に関するご相談はこちら。">
  <Breadcrumbs items={[{ label: 'お問い合わせ' }]} />
  <section class="section pt-6">
    <div class="container grid gap-8 md:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">お問い合わせ</h1>
        <p class="mt-4 text-[color:var(--muted)]">
          メニュー選びで迷う方、鑑定前に確認したいことがある方はLINEからご連絡ください。取材や運営に関するお問い合わせはメールでも承ります。
        </p>
      </div>
      <div class="glass rounded-[8px] p-6">
        <a class="block rounded-full bg-ruby px-6 py-3 text-center font-bold text-white" href={site.lineUrl} data-ga-event="line_click">LINE公式へ</a>
        <a class="mt-3 block rounded-full border border-[var(--line)] px-6 py-3 text-center font-bold" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="mt-4 text-sm text-[color:var(--muted)]">鑑定のご予約はSTORES予約ページからお願いいたします。</p>
      </div>
    </div>
  </section>
</BaseLayout>
