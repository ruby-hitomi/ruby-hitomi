---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
import { services, site } from '@/data/site';
---
<BaseLayout title="料金" description="ルビー瞳の鑑定料金。初回限定15分、通話鑑定30分、通話鑑定60分をSTORES予約からお申し込みいただけます。">
  <Breadcrumbs items={[{ label: '料金' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">料金</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--muted)]">
        お支払いはSTORES予約のカード決済が基本です。正式な空き枠、キャンセル規定、提供条件は予約ページでご確認ください。
      </p>
      <div class="mt-8 overflow-hidden rounded-[8px] border border-[var(--line)]">
        <table class="w-full border-collapse bg-white/55 text-left dark:bg-white/5">
          <thead class="bg-blush/60 dark:bg-ruby/25">
            <tr><th class="p-4">メニュー</th><th class="p-4">時間</th><th class="p-4">料金</th><th class="p-4">予約</th></tr>
          </thead>
          <tbody class="[&_td]:border-t [&_td]:border-[var(--line)] [&_td]:p-4">
            {services.map((service) => (
              <tr>
                <td>{service.title}</td>
                <td>{service.duration}</td>
                <td>{service.price}</td>
                <td><a class="font-bold text-ruby underline underline-offset-4 dark:text-blush" href={service.href ?? site.bookingUrl}>予約へ</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-[color:var(--muted)]">PayPay、Stripe、Squareは将来拡張しやすい構成にしています。</p>
    </div>
  </section>
  <CTA />
</BaseLayout>
