---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
import { services } from '@/data/site';
---
<BaseLayout title="料金" description="ルビー瞳の鑑定料金。STORES予約のカード決済を中心に、将来的なPayPay、Stripe、Square対応も見据えた構成です。">
  <Breadcrumbs items={[{ label: '料金' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">料金</h1>
      <div class="mt-8 overflow-hidden rounded-[8px] border border-[var(--line)]">
        <table class="w-full border-collapse bg-white/55 text-left text-sm dark:bg-white/5">
          <thead class="bg-ruby text-white">
            <tr><th class="p-4">メニュー</th><th class="p-4">時間</th><th class="p-4">料金</th></tr>
          </thead>
          <tbody>
            {services.map((service) => <tr class="border-t border-[var(--line)]"><td class="p-4 font-bold">{service.title}</td><td class="p-4">{service.duration}</td><td class="p-4">{service.price}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="mt-5 text-sm text-[color:var(--muted)]">お支払いはSTORES予約のカード決済が基本です。正式な価格、キャンセル規定、提供条件は予約ページでご確認ください。</p>
    </div>
  </section>
  <CTA />
</BaseLayout>
