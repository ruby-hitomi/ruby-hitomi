---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTA from '@/components/CTA.astro';
import { services, trialNotes } from '@/data/site';
---
<BaseLayout title="鑑定メニュー" description="相手の気持ち鑑定、復縁リーディング、恋愛総合セッション、メール鑑定など、ルビー瞳の鑑定メニュー一覧。">
  <Breadcrumbs items={[{ label: '鑑定メニュー' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">鑑定メニュー</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--muted)]">電話、Zoom、メールからお選びいただけます。予約時に相談内容を簡単にご記入いただくと、鑑定がより深まります。</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
      <aside class="mt-8 rounded-[8px] border border-[var(--line)] bg-white/55 p-5 text-sm dark:bg-white/5">
        <h2 class="font-bold text-ruby dark:text-blush">初回お試し鑑定の注意事項</h2>
        <ul class="mt-3 grid gap-2 text-[color:var(--muted)]">
          {trialNotes.map((note) => <li>{note}</li>)}
        </ul>
      </aside>
    </div>
  </section>
  <CTA />
</BaseLayout>
