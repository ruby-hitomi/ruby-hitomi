---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTA from '@/components/CTA.astro';
import { services } from '@/data/site';

const guideItems = [
  {
    title: '初めて雰囲気を知りたい',
    text: 'まずは初回限定15分がおすすめです。相談内容は1テーマに絞ると話しやすくなります。'
  },
  {
    title: '迷ったら30分',
    text: '相手の気持ち、今の状況、次に取る行動まで落ち着いて確認しやすい標準メニューです。'
  },
  {
    title: '複雑な相談は60分',
    text: '復縁、不倫、結婚、長く続く不安など、背景から丁寧に整理したい方に向いています。'
  }
];

const reassuranceLinks = [
  { href: '/booking/', label: '当日の流れ' },
  { href: '/booking/', label: '通話方法' },
  { href: '/pricing/', label: '支払い方法' },
  { href: '/faq/', label: 'キャンセル・変更' }
];
---
<BaseLayout title="鑑定メニュー" description="ルビー瞳の鑑定メニュー一覧。無料占い、初回限定15分、通話鑑定30分、通話鑑定60分をSTORES予約からお申し込みいただけます。">
  <Breadcrumbs items={[{ label: '鑑定メニュー' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">鑑定メニュー</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--muted)]">
        初めての方は15分のお試し鑑定から。じっくり相談したい方は30分または60分の通話鑑定をお選びください。
      </p>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>

      <section class="mt-8 rounded-[8px] border border-[var(--line)] bg-white/55 p-5 dark:bg-white/5">
        <h2 class="font-serif text-2xl font-bold text-ruby dark:text-blush">メニュー選びの目安</h2>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {guideItems.map((item) => (
            <article class="rounded-[8px] border border-[var(--line)] bg-white/55 p-4 dark:bg-white/5">
              <h3 class="font-bold">{item.title}</h3>
              <p class="mt-2 text-sm text-[color:var(--muted)]">{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <aside class="mt-8 rounded-[8px] border border-[var(--line)] bg-white/55 p-5 text-sm dark:bg-white/5">
        <h2 class="font-bold text-ruby dark:text-blush">初回限定メニューについて</h2>
        <ul class="mt-3 grid gap-2 text-[color:var(--muted)]">
          <li>初回限定15分は、ルビー瞳の鑑定を初めて受ける方のためのメニューです。</li>
          <li>以前に鑑定を受けたことがある方は、通常メニューからご予約ください。</li>
          <li>相談内容が複雑な場合は、30分または60分の鑑定がおすすめです。</li>
        </ul>
      </aside>

      <section class="mt-8 rounded-[8px] border border-[var(--line)] bg-white/55 p-5 dark:bg-white/5">
        <h2 class="font-bold text-ruby dark:text-blush">予約前に確認できます</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {reassuranceLinks.map((item) => (
            <a class="rounded-full border border-[var(--line)] bg-white/60 px-4 py-2 text-sm font-bold text-ruby transition hover:border-ruby dark:bg-white/10 dark:text-blush" href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>
  <CTA />
</BaseLayout>
