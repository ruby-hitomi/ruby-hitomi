---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTA from '@/components/CTA.astro';
import { services } from '@/data/site';
---
<BaseLayout title="鑑定メニュー" description="ルビー瞳の鑑定メニュー一覧。初回限定15分、通話鑑定30分、通話鑑定60分をSTORES予約からお申し込みいただけます。">
  <Breadcrumbs items={[{ label: '鑑定メニュー' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">鑑定メニュー</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--muted)]">
        初めての方は15分のお試し鑑定から。じっくり相談したい方は30分または60分の通話鑑定をお選びください。
      </p>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
      <aside class="mt-8 rounded-[8px] border border-[var(--line)] bg-white/55 p-5 text-sm dark:bg-white/5">
        <h2 class="font-bold text-ruby dark:text-blush">初回限定メニューについて</h2>
        <ul class="mt-3 grid gap-2 text-[color:var(--muted)]">
          <li>初回限定15分は、ルビー瞳の鑑定を初めて受ける方のためのメニューです。</li>
          <li>以前に鑑定を受けたことがある方は、通常メニューからご予約ください。</li>
          <li>相談内容が複雑な場合は、30分または60分の鑑定がおすすめです。</li>
        </ul>
      </aside>
    </div>
  </section>
  <CTA />
</BaseLayout>
