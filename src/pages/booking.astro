---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
import { site } from '@/data/site';

const steps = ['メニューを選ぶ', 'STORES予約で日時を選択', 'カード決済を完了', '鑑定方法の案内を受け取る', '電話・Zoom・メールで鑑定'];
---
<BaseLayout title="予約方法" description="ルビー瞳の鑑定予約方法。STORES予約、LINE公式アカウント、電話鑑定、Zoom鑑定、メール鑑定に対応しています。">
  <Breadcrumbs items={[{ label: '予約方法' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">予約方法</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--muted)]">
        ご予約はSTORES予約から承ります。メニュー選びで迷う場合や、鑑定前に確認したいことがある場合はLINEでご質問ください。
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="rounded-full bg-ruby px-6 py-3 text-center font-bold text-white shadow-glass" href={site.bookingUrl} data-ga-event="stores_booking_click">予約ページへ進む</a>
        <a class="rounded-full border border-[var(--line)] bg-white/50 px-6 py-3 text-center font-bold text-ruby dark:bg-white/10 dark:text-blush" href={site.lineUrl} data-ga-event="line_click">LINEで質問する</a>
      </div>
      <ol class="mt-8 grid gap-4 md:grid-cols-5">
        {steps.map((step, index) => (
          <li class="glass rounded-[8px] p-5">
            <span class="font-serif text-3xl font-bold text-gold">0{index + 1}</span>
            <p class="mt-3 font-bold">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CTA />
</BaseLayout>
