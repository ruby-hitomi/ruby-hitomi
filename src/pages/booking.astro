---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
---
<BaseLayout title="予約方法" description="ルビー瞳の鑑定予約方法。STORES予約、LINE公式アカウント、Zoom、電話鑑定、メール鑑定の流れ。">
  <Breadcrumbs items={[{ label: '予約方法' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">予約方法</h1>
      <ol class="mt-8 grid gap-4 md:grid-cols-4">
        {['メニューを選ぶ', 'STORES予約で日時を選択', 'カード決済', 'Zoom・電話・メールで鑑定'].map((step, index) => (
          <li class="glass rounded-[8px] p-5">
            <span class="font-serif text-3xl font-bold text-gold">0{index + 1}</span>
            <p class="mt-3 font-bold">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CTA />
</BaseLayout>
