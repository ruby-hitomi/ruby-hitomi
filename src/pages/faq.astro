---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
const faqs = [
  ['初めてでも大丈夫ですか？', 'はい。状況を整理しながら丁寧に伺いますので、うまく話せなくても大丈夫です。'],
  ['復縁できるか見てもらえますか？', '復縁の可能性、相手の気持ち、連絡のタイミング、今避けたい行動を総合的に読み解きます。'],
  ['電話占いとメール鑑定は選べますか？', 'はい。Zoom、電話、メール鑑定に対応しています。'],
  ['鑑定結果が悪い場合も伝えますか？', '必要なことは誠実にお伝えしつつ、現実的にできる対策まで一緒に整理します。']
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
};
---
<BaseLayout title="よくある質問" description="ルビー瞳の占い鑑定に関するよくある質問。初回相談、復縁、電話占い、メール鑑定について。" schema={schema}>
  <Breadcrumbs items={[{ label: 'よくある質問' }]} />
  <section class="section pt-6">
    <div class="container max-w-3xl">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">よくある質問</h1>
      <div class="mt-8 grid gap-4">
        {faqs.map(([q, a]) => (
          <details class="glass rounded-[8px] p-5">
            <summary class="cursor-pointer font-bold">{q}</summary>
            <p class="mt-3 text-[color:var(--muted)]">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
