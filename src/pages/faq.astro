---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
import { faqs } from '@/data/site';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer }
  }))
};
---
<BaseLayout title="よくある質問" description="ルビー瞳の鑑定予約、支払い、相談内容、電話・Zoom・メール鑑定についてのよくある質問。" schema={schema}>
  <Breadcrumbs items={[{ label: 'よくある質問' }]} />
  <section class="section pt-6">
    <div class="container max-w-3xl">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">よくある質問</h1>
      <div class="mt-8 grid gap-4">
        {faqs.map((faq) => (
          <details class="glass rounded-[8px] p-5">
            <summary class="cursor-pointer font-bold">{faq.question}</summary>
            <p class="mt-3 text-[color:var(--muted)]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
