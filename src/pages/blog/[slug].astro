---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTA from '@/components/CTA.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const shareUrl = new URL(`/blog/${post.slug}/`, site.url).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.name },
  publisher: { '@type': 'Organization', name: site.title },
  mainEntityOfPage: shareUrl
};
---
<BaseLayout title={post.data.title} description={post.data.description} canonical={`/blog/${post.slug}/`} type="article" schema={schema}>
  <Breadcrumbs items={[{ href: '/blog/', label: 'ブログ' }, { label: post.data.title }]} />
  <article class="section pt-6">
    <div class="container grid gap-8 lg:grid-cols-[220px_1fr]">
      <aside class="hidden lg:block">
        <div class="glass sticky top-28 rounded-[8px] p-5">
          <p class="font-bold">目次</p>
          <ol class="mt-3 grid gap-2 text-sm text-[color:var(--muted)]">
            {headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </div>
      </aside>
      <div>
        <p class="text-sm font-bold tracking-[0.18em] text-gold">{post.data.category}</p>
        <h1 class="mt-3 font-serif text-4xl font-bold leading-tight text-ruby dark:text-blush">{post.data.title}</h1>
        <p class="mt-4 text-[color:var(--muted)]">{post.data.description}</p>
        <div class="mt-5 flex flex-wrap gap-2 text-sm">
          {post.data.tags.map((tag) => <span class="rounded-full border border-[var(--line)] px-3 py-1">#{tag}</span>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-2 text-sm">
          <a class="rounded-full bg-ruby px-4 py-2 text-white" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.data.title)}`}>Xでシェア</a>
          <a class="rounded-full border border-[var(--line)] px-4 py-2" href={site.lineUrl}>LINEで相談</a>
        </div>
        <div class="prose-ruby mt-10 max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>
  <CTA />
</BaseLayout>
