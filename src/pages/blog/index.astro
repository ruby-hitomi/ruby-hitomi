---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map((post) => post.data.category))];
---
<BaseLayout title="ブログ" description="恋愛占い、復縁占い、相手の気持ち、タロット占い、ルノルマンカードに関するSEOコラム。">
  <Breadcrumbs items={[{ label: 'ブログ' }]} />
  <section class="section pt-6">
    <div class="container">
      <h1 class="font-serif text-4xl font-bold text-ruby dark:text-blush">ブログ</h1>
      <p class="mt-4 max-w-2xl text-[color:var(--muted)]">恋に迷ったとき、気持ちを整えるためのコラムを更新しています。カテゴリ、タグ、関連記事を増やしやすい構造です。</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {categories.map((category) => <span class="rounded-full border border-[var(--line)] px-3 py-1 text-sm text-[color:var(--muted)]">{category}</span>)}
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {posts.map((post) => <BlogCard href={`/blog/${post.slug}/`} title={post.data.title} description={post.data.description} category={post.data.category} pubDate={post.data.pubDate} />)}
      </div>
    </div>
  </section>
</BaseLayout>
